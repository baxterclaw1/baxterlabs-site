---
const markSrc = `/logos/bl-stencil-lcoral-bcream-thick.png?v=3`;
---

<header class="nav">
  <div class="nav-inner">
    <a class="nav-logo" href="/" aria-label="BaxterLabs home">
      <img class="nav-mark" src={markSrc} alt="" width="40" height="44" />
      <span class="nav-type">
        <span class="nav-axter">axter</span>
        <span class="nav-labs">Labs</span>
      </span>
    </a>
  </div>
</header>

<style>
  .nav {
    width: 100%;
    background: var(--site-bg);
    position: relative;
    z-index: 40;
  }

  .nav-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1.2rem var(--section-pad-x);
    max-width: var(--content-width);
    width: 100%;
    margin: 0 auto;
    box-sizing: border-box;
  }

  .nav-logo {
    --logo-size: 2.1rem;
    display: inline-flex;
    align-items: center;
    gap: 0.05em;
    min-width: 0;
    font-size: var(--logo-size);
    font-weight: 600;
    text-decoration: none;
    color: var(--site-text);
    line-height: 1;
    border-bottom: 2px solid var(--site-accent);
    padding-bottom: 0.14rem;
  }

  /* Match winner: B reads as the capital — taller than lowercase axter */
  .nav-mark {
    height: 1em;
    width: auto;
    display: block;
    flex-shrink: 0;
  }

  .nav-type {
    display: inline-flex;
    align-items: baseline;
    gap: 0.12em;
    /* Only change vs winner: slight drop toward the B foot */
    transform: translateY(0.08em);
  }

  .nav-axter {
    letter-spacing: -0.035em;
  }

  .nav-labs {
    font-size: 0.5em;
    font-weight: 600;
    letter-spacing: 0.01em;
    color: var(--site-accent);
  }

  @media (max-width: 520px) {
    .nav-inner {
      padding: 1rem var(--section-pad-x);
    }

    .nav-logo {
      --logo-size: 1.55rem;
    }
  }

  @media (max-width: 360px) {
    .nav-logo {
      --logo-size: 1.35rem;
    }
  }
</style>
