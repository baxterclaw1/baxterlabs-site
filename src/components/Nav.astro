---
const markSrc = `/logos/bl-stencil-lcoral-bcream-thick.png?v=3`;
---

<header class="nav">
  <div class="nav-inner">
    <a class="nav-logo" href="/" aria-label="BaxterLabs home">
      <img class="nav-mark" src={markSrc} alt="" width="40" height="44" />
      <span class="nav-type">
        <span class="nav-axter">axter</span>
        <span class="nav-labs">Labs</span>
      </span>
    </a>

    <nav class="nav-links" aria-label="Page">
      <a href="/#what-to-expect" data-scroll-to="what-to-expect">What to expect</a>
      <a href="/#built-for-how-you-run" data-scroll-to="built-for-how-you-run">How you run</a>
      <a href="/#about" data-scroll-to="about">About</a>
    </nav>

    <a class="btn nav-cta" href="/#contact" data-scroll-to="contact">Partner with us</a>
  </div>
</header>

<style>
  .nav {
    width: 100%;
    background: var(--site-bg);
    position: sticky;
    top: 0;
    z-index: 100;
    border-bottom: 1px solid var(--site-border);
  }

  .nav-inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
    align-items: center;
    gap: 1rem;
    padding: 0.85rem var(--section-pad-x);
    max-width: var(--content-width);
    width: 100%;
    margin: 0 auto;
    box-sizing: border-box;
    min-height: var(--nav-height);
  }

  .nav-logo {
    --logo-size: 2.1rem;
    display: inline-flex;
    align-items: center;
    gap: 0.05em;
    min-width: 0;
    justify-self: start;
    font-size: var(--logo-size);
    font-weight: 600;
    text-decoration: none;
    color: var(--site-text);
    line-height: 1;
    border-bottom: 2px solid var(--site-accent);
    padding-bottom: 0.14rem;
  }

  .nav-mark {
    height: 1em;
    width: auto;
    display: block;
    flex-shrink: 0;
  }

  .nav-type {
    display: inline-flex;
    align-items: baseline;
    gap: 0.12em;
    transform: translateY(0.08em);
  }

  .nav-axter {
    letter-spacing: -0.035em;
  }

  .nav-labs {
    font-size: 0.5em;
    font-weight: 600;
    letter-spacing: 0.01em;
    color: var(--site-accent);
  }

  .nav-links {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1.75rem;
    justify-self: center;
  }

  .nav-links a {
    font-size: 0.9375rem;
    font-weight: 500;
    letter-spacing: -0.01em;
    color: var(--site-text-dim);
    text-decoration: none;
    white-space: nowrap;
    transition: color 0.15s ease;
  }

  .nav-links a:hover,
  .nav-links a:focus-visible {
    color: var(--site-text);
  }

  .nav-cta {
    justify-self: end;
    font-size: 0.8125rem;
    padding: 0.55rem 1rem 0.55rem 1.15rem;
    box-shadow: 0 8px 20px rgba(224, 122, 95, 0.22);
  }

  .nav-cta::after {
    font-size: 0.9rem;
  }

  @media (max-width: 800px) {
    .nav-inner {
      grid-template-columns: minmax(0, 1fr) auto;
    }

    .nav-links {
      display: none;
    }
  }

  @media (max-width: 520px) {
    .nav-inner {
      padding: 0.7rem var(--section-pad-x);
    }

    .nav-logo {
      --logo-size: 1.55rem;
    }

    .nav-cta {
      font-size: 0.75rem;
      padding: 0.45rem 0.85rem 0.45rem 1rem;
    }
  }

  @media (max-width: 360px) {
    .nav-logo {
      --logo-size: 1.35rem;
    }

    .nav-cta {
      font-size: 0.7rem;
      padding: 0.4rem 0.7rem 0.4rem 0.85rem;
    }
  }
</style>
