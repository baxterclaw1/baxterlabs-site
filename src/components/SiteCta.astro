---
interface Props {
  heading?: string;
  subtitle?: string;
  businessLabel?: string;
  businessPlaceholder?: string;
  messageLabel?: string;
  messagePlaceholder?: string;
  buttonLabel?: string;
  source?: string;
  hideSlot?: boolean;
  successLead?: string;
  successConfirm?: string;
}

const contactEmail = 'info@baxterlabs.io';
const web3formsKey = '2dc63a98-1878-4b54-96f7-38297382172e';

const {
  heading = "Ready to see what's possible?",
  subtitle = "Book a 30-minute consultation. We'll discuss your biggest bottlenecks and explore if automation is right for you.",
  businessLabel = 'Business',
  businessPlaceholder = 'Company name',
  messageLabel = "What's going on",
  messagePlaceholder = "About your business, the tools you use, questions, or a job description you'd like automated.",
  buttonLabel = 'Submit',
  source = '',
  hideSlot = false,
  successLead = "Thanks for reaching out. We'll get back to you asap.",
  successConfirm = "Thanks for reaching out. We'll get back to you asap. We sent a confirmation to {email}.",
} = Astro.props;
---

<section class="site-cta" aria-labelledby="cta-heading">
  <div class="site-cta-panel">
    {!hideSlot && (
      <>
        <slot />
        <hr class="cta-box-sep" />
      </>
    )}
    <div class="site-contact-block" id="contact">
    <div class="site-section-head">
      <h2 id="cta-heading" class="site-section-title">{heading}</h2>
      <p class="site-section-subtitle">{subtitle}</p>
    </div>

    <form class="site-contact" id="contact-form" novalidate>
      <input type="checkbox" name="botcheck" class="site-contact-honeypot" tabindex="-1" autocomplete="off" aria-hidden="true" />
      {source && <input type="hidden" name="source" value={source} />}

      <div class="site-contact-row">
        <label class="site-contact-field">
          <span>Name</span>
          <input type="text" name="name" required autocomplete="name" placeholder="Your name" />
        </label>
        <label class="site-contact-field">
          <span>Email</span>
          <input type="email" name="email" required autocomplete="email" placeholder="you@company.com" />
        </label>
      </div>

      <label class="site-contact-field">
        <span>{businessLabel} <em>(optional)</em></span>
        <input type="text" name="business" autocomplete="organization" placeholder={businessPlaceholder} />
      </label>

      <label class="site-contact-field">
        <span>{messageLabel}</span>
        <textarea
          name="message"
          required
          rows="5"
          placeholder={messagePlaceholder}
        ></textarea>
      </label>

      <div class="site-contact-footer">
        <button class="btn" type="submit" id="contact-submit">{buttonLabel}</button>
        <p class="site-contact-status" id="contact-status" role="status" aria-live="polite" hidden></p>
      </div>
    </form>
    </div>
  </div>
</section>

<script define:vars={{ contactEmail, web3formsKey, buttonLabel, successLead, successConfirm }}>
  const form = document.getElementById('contact-form');
  const submitBtn = document.getElementById('contact-submit');
  const statusEl = document.getElementById('contact-status');

  async function submitWeb3Forms(formEl) {
    const data = new FormData(formEl);
    const src = String(data.get('source') || '').trim();
    data.append('access_key', web3formsKey);
    data.append('subject', src === 'lawyer' ? 'BaxterLabs /lawyer inquiry' : 'BaxterLabs site inquiry');
    data.append('from_name', 'BaxterLabs website');
    const res = await fetch('https://api.web3forms.com/submit', {
      method: 'POST',
      body: data,
    });
    const json = await res.json().catch(() => ({}));
    if (!res.ok || json.success === false) throw new Error('Request failed');
  }

  if (form && submitBtn && statusEl) {
    form.addEventListener('submit', async (event) => {
      event.preventDefault();

      const honeypot = form.querySelector('[name="botcheck"]');
      if (honeypot instanceof HTMLInputElement && honeypot.checked) return;

      if (!form.checkValidity()) {
        form.reportValidity();
        return;
      }

      const fields = new FormData(form);
      const visitorEmail = String(fields.get('email') || '').trim();

      submitBtn.disabled = true;
      submitBtn.textContent = 'Sending…';
      statusEl.hidden = true;

      try {
        let confirmationSent = false;
        const payload = {
          name: String(fields.get('name') || '').trim(),
          email: visitorEmail,
          business: String(fields.get('business') || '').trim(),
          message: String(fields.get('message') || '').trim(),
          source: String(fields.get('source') || '').trim(),
          botcheck: honeypot instanceof HTMLInputElement ? honeypot.checked : false,
        };

        const res = await fetch('/api/contact', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
        });

        const type = res.headers.get('content-type') || '';
        if (res.status === 404 || !type.includes('application/json')) {
          await submitWeb3Forms(form);
        } else {
          const json = await res.json().catch(() => ({}));
          if (json.ok === true) {
            confirmationSent = Boolean(json.confirmationSent);
          } else {
            await submitWeb3Forms(form);
          }
        }

        form.reset();
        statusEl.hidden = false;
        statusEl.dataset.state = 'ok';
        statusEl.textContent = confirmationSent
          ? successConfirm.replace('{email}', visitorEmail)
          : successLead;
      } catch {
        statusEl.hidden = false;
        statusEl.dataset.state = 'err';
        statusEl.textContent = `Couldn't send that. Email us at ${contactEmail}.`;
      } finally {
        submitBtn.disabled = false;
        submitBtn.textContent = buttonLabel;
      }
    });
  }
</script>

<style>
  .site-cta {
    width: 100%;
    max-width: none;
    margin: 0;
    padding: 0 var(--section-pad-x) var(--section-pad-y);
    background: linear-gradient(
      180deg,
      rgba(224, 122, 95, 0) 0%,
      rgba(224, 122, 95, 0.06) 28%,
      rgba(224, 122, 95, 0.1) 52%,
      rgba(224, 122, 95, 0.04) 78%,
      var(--site-bg) 100%
    );
    position: relative;
  }

  .site-contact-block {
    scroll-margin-top: calc(var(--nav-height) + 0.75rem);
  }

  .site-cta-panel :global(.about) {
    padding-left: 0;
    padding-right: 0;
  }

  .site-cta-panel {
    max-width: var(--content-width);
    margin: 0 auto;
    border: 1px solid rgba(224, 122, 95, 0.35);
    background: var(--site-bg);
    box-shadow:
      0 0 0 1px rgba(224, 122, 95, 0.1),
      0 0 36px rgba(224, 122, 95, 0.22),
      0 0 80px rgba(224, 122, 95, 0.1);
    padding: clamp(2rem, 4vw, 3rem) clamp(1.5rem, 4vw, 2.75rem) clamp(2rem, 4vw, 2.75rem);
  }

  :global(.cta-box-sep) {
    border: none;
    border-top: 1px solid rgba(224, 122, 95, 0.2);
    margin: clamp(1.5rem, 3vw, 2.5rem) 0;
    width: 100%;
  }

  .site-cta-panel .site-section-head {
    margin-bottom: 2.25rem;
  }

  .site-contact {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    max-width: 48rem;
    margin: 0 auto;
    width: 100%;
  }

  .site-contact-honeypot {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  .site-contact-row {
    display: grid;
    gap: 1rem;
  }

  @media (min-width: 560px) {
    .site-contact-row {
      grid-template-columns: 1fr 1fr;
    }
  }

  .site-contact-field {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    font-size: 0.8125rem;
    color: var(--site-text-dim);
  }

  .site-contact-field em {
    font-style: normal;
    color: var(--site-text-muted);
  }

  .site-contact-field input,
  .site-contact-field textarea {
    width: 100%;
    padding: 0.75rem 0.9rem;
    font-family: inherit;
    font-size: 0.9375rem;
    color: var(--site-text);
    background: var(--site-surface);
    border: 1px solid var(--site-border);
    border-radius: 0;
    outline: none;
    transition: border-color 0.15s ease, box-shadow 0.15s ease;
  }

  .site-contact-field textarea {
    resize: none;
    min-height: 8rem;
    line-height: 1.5;
  }

  .site-contact-field input::placeholder,
  .site-contact-field textarea::placeholder {
    color: var(--site-text-muted);
    font-style: italic;
  }

  .site-contact-field input:focus,
  .site-contact-field textarea:focus {
    border-color: var(--site-accent);
    box-shadow: 0 0 0 3px var(--site-glow);
  }

  .site-contact-footer {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    margin-top: clamp(1.25rem, 2.5vw, 1.75rem);
  }

  .site-contact-footer .btn {
    font-size: 1.0625rem;
    padding: 0.95rem 1.55rem 0.95rem 1.85rem;
  }

  .site-contact-footer .btn:disabled {
    opacity: 0.7;
    cursor: wait;
    transform: none;
    box-shadow: none;
  }

  .site-contact-status {
    font-size: 0.875rem;
    color: var(--site-text-dim);
    max-width: 28rem;
    text-wrap: pretty;
  }

  .site-contact-status[data-state='ok'] {
    color: #8fbf9f;
  }

  .site-contact-status[data-state='err'] {
    color: var(--site-accent);
  }
</style>
