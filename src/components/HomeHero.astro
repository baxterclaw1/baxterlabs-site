---

---

<section class="hero" id="top">
  <div class="hero-bg" aria-hidden="true"></div>
  <div class="hero-inner">
    <h1 class="hero-title">
      <span class="hero-line">Your business evolves.</span>
      <span class="hero-line">Your tools should too.</span>
    </h1>
    <p class="hero-sub">
      Custom operations &amp; automation for SMBs. Connect tools, streamline tasks,
      consolidate scattered work into one system.
    </p>
    <a class="btn hero-cta" href="#contact" data-scroll-to="contact">Partner with us</a>
  </div>
</section>

<style>
  .hero {
    position: relative;
    max-width: var(--content-width);
    margin: 0 auto;
    padding: 0 var(--section-pad-x);
    /* Fill the first screen so How we work starts below the fold */
    min-height: calc(100dvh - 3.25rem);
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  .hero-bg {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 0;
    background:
      radial-gradient(ellipse 90% 58% at 50% 0%, rgba(224, 122, 95, 0.18), transparent 60%),
      radial-gradient(ellipse 45% 35% at 70% 40%, rgba(255, 255, 255, 0.04), transparent 50%);
  }

  .hero-inner {
    position: relative;
    width: 100%;
    max-width: 58rem;
    /* Half the previous lift — nudged up from center, not top-heavy */
    padding: clamp(2rem, 5vw, 3.5rem) 0 clamp(1.5rem, 3vw, 2rem);
    transform: translateY(-9vh);
    text-align: center;
    z-index: 1;
  }

  .hero-title {
    font-size: clamp(2.835rem, 8.55vw, 5.175rem);
    font-weight: 600;
    letter-spacing: -0.035em;
    line-height: 1.08;
  }

  .hero-line {
    display: block;
  }

  @media (prefers-reduced-motion: no-preference) {
    .hero-line {
      animation: hero-rise 0.55s ease-out both;
    }

    .hero-line:nth-child(2) {
      animation-delay: 0.12s;
    }

    .hero-sub {
      animation: hero-fade 0.5s ease-out 0.3s both;
    }

    .hero-cta {
      animation: hero-fade 0.5s ease-out 0.38s both;
    }

    @keyframes hero-rise {
      from {
        opacity: 0;
        transform: translateY(16px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    @keyframes hero-fade {
      from {
        opacity: 0;
        transform: translateY(10px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }
  }

  .hero-sub {
    font-size: clamp(1.18125rem, 2.52vw, 1.51875rem);
    font-weight: 500;
    letter-spacing: -0.015em;
    line-height: 1.4;
    color: var(--site-text-dim);
    max-width: 42rem;
    margin: clamp(1rem, 2vw, 1.25rem) auto 0;
    text-wrap: pretty;
  }

  .hero-cta {
    margin-top: clamp(1.5rem, 2.8vw, 2rem);
    font-size: clamp(1rem, 1.5vw, 1.125rem);
    padding: 0.85rem 1.5rem 0.85rem 1.85rem;
  }

  /* Phone only — larger type, still fits the longest rotating phrases */
  @media (max-width: 640px) {
    .hero {
      padding: 0 1rem;
      max-width: 100%;
    }

    .hero-inner {
      max-width: 100%;
      transform: translateY(-6vh);
    }

    .hero-title {
      /* ~60% of the way back from the too-small pass toward the original 3.15rem */
      font-size: clamp(2.4rem, 9.7vw, 2.75rem);
      letter-spacing: -0.035em;
    }

    .hero-line {
      white-space: normal;
    }

    .hero-sub {
      font-size: clamp(1.15rem, 4.2vw, 1.3rem);
      max-width: 26rem;
    }
  }

  /* Fold cover / very narrow — prevent overflow that triggers page shrink */
  @media (max-width: 400px) {
    .hero {
      padding: 0 0.75rem;
    }

    .hero-inner {
      transform: translateY(-4vh);
    }

    .hero-title {
      font-size: clamp(1.85rem, 9.5vw, 2.35rem);
    }

    .hero-line {
      white-space: normal;
    }

    .hero-sub {
      font-size: clamp(1rem, 4vw, 1.15rem);
    }
  }

</style>
