---

---

<section class="hero" id="top">
  <div class="hero-bg" aria-hidden="true"></div>
  <div class="hero-inner">
    <h1 class="hero-title">
      <span class="hero-line">More Cook County appeals.</span>
      <span class="hero-line">Less clerical grind.</span>
    </h1>
    <p class="hero-sub">
      We build and run the intake-to-signature workflow for Illinois property tax
      appeal firms that file in Cook County. County data, Smokeball, retainer packets,
      and e-sign, connected so your staff isn't copying the same PIN into four places.
    </p>
    <div class="hero-actions">
      <a class="btn hero-cta" href="#contact" data-scroll-to="contact">Schedule a workflow assessment</a>
      <a class="hero-jump" href="#case-study" data-scroll-to="case-study">See the work</a>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    max-width: var(--content-width);
    margin: 0 auto;
    padding: 0 var(--section-pad-x);
    min-height: max(28rem, calc(100dvh - var(--nav-height) - 20vh));
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  .hero-bg {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 0;
    background:
      radial-gradient(ellipse 90% 58% at 50% 0%, rgba(224, 122, 95, 0.18), transparent 60%),
      radial-gradient(ellipse 45% 35% at 70% 40%, rgba(255, 255, 255, 0.04), transparent 50%);
  }

  .hero-inner {
    position: relative;
    width: 100%;
    max-width: 58rem;
    padding: clamp(2rem, 5vw, 3.5rem) 0 clamp(1.5rem, 3vw, 2rem);
    text-align: center;
    z-index: 1;
  }

  .hero-title {
    font-size: clamp(2.5rem, 7.4vw, 4.6rem);
    font-weight: 600;
    letter-spacing: -0.035em;
    line-height: 1.08;
  }

  .hero-line {
    display: block;
  }

  @media (prefers-reduced-motion: no-preference) {
    .hero-line {
      animation: hero-rise 0.55s ease-out both;
    }

    .hero-line:nth-child(2) {
      animation-delay: 0.12s;
    }

    .hero-sub {
      animation: hero-fade 0.5s ease-out 0.3s both;
    }

    .hero-actions {
      animation: hero-fade 0.5s ease-out 0.38s both;
    }

    @keyframes hero-rise {
      from {
        opacity: 0;
        transform: translateY(16px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    @keyframes hero-fade {
      from {
        opacity: 0;
        transform: translateY(10px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }
  }

  .hero-sub {
    font-size: clamp(1.1rem, 2.2vw, 1.4rem);
    font-weight: 500;
    letter-spacing: -0.015em;
    line-height: 1.45;
    color: var(--site-text-dim);
    max-width: 44rem;
    margin: clamp(1rem, 2vw, 1.25rem) auto 0;
    text-wrap: pretty;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 1.25rem 1.75rem;
    margin-top: clamp(1.5rem, 2.8vw, 2rem);
  }

  .hero-cta {
    font-size: clamp(0.95rem, 1.4vw, 1.0625rem);
    padding: 0.85rem 1.4rem 0.85rem 1.7rem;
  }

  .hero-jump {
    font-size: 1rem;
    font-weight: 500;
    color: var(--site-text-dim);
    text-decoration: none;
    border-bottom: 1px solid rgba(224, 122, 95, 0.45);
    padding-bottom: 0.12rem;
    transition: color 0.15s ease, border-color 0.15s ease;
  }

  .hero-jump:hover,
  .hero-jump:focus-visible {
    color: var(--site-text);
    border-bottom-color: var(--site-accent);
  }

  @media (max-width: 640px) {
    .hero {
      padding: 0 1rem;
      max-width: 100%;
    }

    .hero-inner {
      max-width: 100%;
    }

    .hero-title {
      font-size: clamp(2.1rem, 8.8vw, 2.55rem);
    }

    .hero-sub {
      font-size: clamp(1.05rem, 4vw, 1.2rem);
      max-width: 28rem;
    }
  }

  @media (max-width: 400px) {
    .hero {
      padding: 0 0.75rem;
    }

    .hero-title {
      font-size: clamp(1.75rem, 9vw, 2.15rem);
    }

    .hero-cta {
      white-space: normal;
      text-wrap: balance;
    }
  }
</style>
