<header class="pg-nav" id="top">
  <div class="pg-nav-inner">
    <a class="pg-nav-logo" href="/playground" aria-label="BaxterLabs home">BaxterLabs</a>
    <a class="pg-nav-cta" href="#contact" data-scroll-to="contact">Partner with us</a>
  </div>
</header>

<style>
  .pg-nav {
    position: sticky;
    top: 0;
    left: 0;
    width: 100%;
    z-index: 100;
    background: var(--site-bg);
    border-bottom: 1px solid var(--site-border);
  }

  .pg-nav-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.9rem var(--section-pad-x);
    max-width: var(--content-width);
    width: 100%;
    margin: 0 auto;
  }

  .pg-nav-logo {
    display: inline-block;
    text-decoration: none;
    color: var(--site-text);
    min-width: 0;
    font-size: 1.3rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .pg-nav-cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.55rem 1.15rem;
    font-family: inherit;
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.01em;
    color: #0a0b0d;
    background: var(--site-accent);
    border: none;
    border-radius: 0;
    text-decoration: none;
    cursor: pointer;
    white-space: nowrap;
    flex-shrink: 0;
    transition: background 0.2s ease, transform 0.15s ease;
  }

  .pg-nav-cta:hover {
    background: var(--site-accent-hover);
    transform: translateY(-1px);
  }

  .pg-nav-cta:active {
    transform: translateY(0) scale(0.98);
  }

  @media (max-width: 520px) {
    .pg-nav-inner {
      padding: 0.7rem var(--section-pad-x);
      gap: 0.5rem;
    }

    .pg-nav-logo {
      font-size: 1.1rem;
    }

    .pg-nav-cta {
      padding: 0.45rem 0.85rem;
      font-size: 0.75rem;
    }
  }

  @media (max-width: 360px) {
    .pg-nav-logo {
      font-size: 0.95rem;
    }

    .pg-nav-cta {
      padding: 0.4rem 0.7rem;
      font-size: 0.7rem;
    }
  }
</style>
